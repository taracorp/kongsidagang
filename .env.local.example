# Database (Prisma) — Postgres di VPS. Dev: buka tunnel dulu
#   ssh -N -L 5434:127.0.0.1:5434 root@31.97.49.146
DATABASE_URL=postgresql://kongsi:PASSWORD@127.0.0.1:5434/kongsi_dev

# Better Auth — secret acak (openssl rand -hex 32) & URL publik aplikasi
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Login Google (opsional; redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron lelang (crontab VPS memanggil /api/cron/advance-auctions dengan Bearer ini)
CRON_SECRET=
# Kunci kode ketemu Tukar Guling (QR/6 digit). Kosong → memakai BETTER_AUTH_SECRET.
BARTER_QR_SECRET=

# Folder unggahan foto (Tukar Guling)
UPLOAD_DIR=./.uploads

# Isi Pundi demo (true hanya untuk uji; matikan di produksi sampai DOKU siap)
ENABLE_TOPUP_DEMO=false

# Superadmin: selalu Ketua Kongsi & perannya tak bisa dicabut (pisahkan dengan koma)
SUPERADMIN_EMAILS=

# Akun awal untuk `npm run seed` (admin jadi Ketua Kongsi)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TESTER_EMAIL=
SEED_TESTER_PASSWORD=

# Sekilas Pariwara (iklan) — tampil di Beranda saat TIDAK ada lelang aktif.
# Isi salah satu (video diprioritaskan). Kosongkan untuk pakai placeholder.
NEXT_PUBLIC_AD_VIDEO_URL=
NEXT_PUBLIC_AD_IMAGE_URL=
# KiriminAja (Tukar Guling mode Kirim). Tanpa API key + KIRIMINAJA_MOCK=true → driver tiruan (dev/uji).
# Webhook: daftarkan https://<domain>/api/kiriminaja/webhook lewat POST /api/mitra/set_callback.
KIRIMINAJA_API_KEY=
KIRIMINAJA_BASE_URL=https://client.kiriminaja.com
KIRIMINAJA_PIN=
KIRIMINAJA_MOCK=
# DOKU Checkout (Isi Pundi). Kredensial dari DOKU Back Office → Integration → API Keys.
# Kongsi memakai PRODUKSI langsung (keputusan Tara 6 Okt 2026). Butuh Secret Key (SK-…), bukan "API Key". DOKU_MOCK=true → halaman bayar tiruan (dev/uji).
# Notifikasi: daftarkan https://<domain>/api/doku/notifikasi di Back Office.
DOKU_BASE_URL=https://api.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=
DOKU_MOCK=
