// Kongsi Dagang — skema database (Prisma, Postgres 16 di VPS).
// Diturunkan dari supabase/migrations 0001–0016 (arsip: docs/arsip-supabase/).
// Nama kolom sengaja snake_case = sama dengan skema lama, supaya lapisan data mudah dibaca.
// Tabel Better Auth (user/session/account/verification) memakai camelCase sesuai kebutuhan Better Auth.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Better Auth (pengganti auth.users Supabase)
// ============================================================
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  profile             Profile?
  wallet              Wallet?
  staffRole           StaffRole?             @relation("StaffRoleUser")
  grantedRoles        StaffRole[]            @relation("StaffRoleGrantedBy")
  merchants           Merchant[]
  applications        MerchantApplication[]
  auctionsWon         Auction[]
  auctionParticipants AuctionParticipant[]
  auctionGuesses      AuctionGuess[]
  barterItems         BarterItem[]
  ratingsGiven        BarterRating[]         @relation("RatingRater")
  ratingsReceived     BarterRating[]         @relation("RatingRatee")
  vouchers            Voucher[]
  walletTransactions  WalletTransaction[]
  walletHolds         WalletHold[]
  addresses           UserAddress[]
  topupOrders         TopupOrder[]
  orders              Order[]
  notifications       Notification[]
  follows             Follow[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Enum
// ============================================================
enum UserLevel {
  pelanggan_kecil
  pelanggan_besar
  tuan_kecil
  tuan_besar
  juragan

  @@map("user_level")
}

enum StaffRoleKind {
  pewarta
  admin
  ketua

  @@map("staff_role")
}

// ============================================================
// Loji / Saudagar
// ============================================================
model Merchant {
  id                 String    @id @default(uuid())
  slug               String    @unique
  name               String
  category           String
  rating             Decimal   @default(0) @db.Decimal(2, 1)
  tebusan_count      Int       @default(0)
  tone               String    @default("indigo")
  cover_from         String?
  cover_to           String?
  city               String?
  is_sealed          Boolean   @default(false)
  status             String    @default("buka") // buka | obral | tutup | segera
  flash_sale_ends_at DateTime?
  owner_id           String?
  owner              User?     @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now())

  // Profil lapak (tenant asli)
  logo_url    String?
  description String?
  whatsapp    String?
  website     String?
  hours       String? // mis. "Senin–Minggu 09.00–18.00"

  products      MerchantProduct[]
  priceListings PriceListing[]
  follows       Follow[]
  branches      MerchantBranch[]
  orderItems    OrderItem[]
  vouchers      Voucher[]

  @@map("merchants")
}

model MerchantProduct {
  id          String   @id @default(uuid())
  merchant_id String
  merchant    Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  name        String
  price       Int // Keping (1 keping = Rp 1)
  old_price   Int?
  tone        String   @default("sage")
  tags        String[] @default([])
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  kind        String  @default("evoucher") // evoucher | barang
  category    String? // kelompok di halaman lapak, mis. "Glimmer Glow"
  description String?
  valid_days  Int     @default(90) // masa berlaku e-voucher sejak dibeli
  image_url   String?
  is_featured Boolean @default(false) // tampil di Etalase Beranda
  sort        Int     @default(0)

  orderItems OrderItem[]
  vouchers   Voucher[]

  @@index([merchant_id])
  @@map("merchant_products")
}

// Cabang lapak — e-voucher dipilih cabangnya saat beli dan hanya sah di cabang itu.
model MerchantBranch {
  id          String   @id @default(uuid())
  merchant_id String
  merchant    Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  name        String
  address     String
  city        String?
  is_active   Boolean  @default(true)
  sort        Int      @default(0)
  created_at  DateTime @default(now())

  orderItems OrderItem[]
  vouchers   Voucher[]

  @@index([merchant_id])
  @@map("merchant_branches")
}

// Pesanan belanja (dibayar Keteng). Harga diambil dari DB saat checkout, bukan dari browser.
model Order {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subtotal       Int // harga e-voucher (titipan milik lapak)
  bea            Int // platform fee (+ PPN bila PKP) — pendapatan Kongsi
  biaya_bayar    Int       @default(0) // biaya DOKU (termasuk PPN) yang ditanggung pembeli
  total          Int // dibayar pembeli = subtotal + bea + biaya_bayar
  status         String    @default("menunggu") // menunggu | lunas | gagal | kedaluwarsa
  invoice_number String?   @unique
  metode         String? // kode DOKU payment_method_types yang dipilih
  channel        String? // kanal yang dilaporkan DOKU saat lunas
  provider       String? // doku | tiruan | demo (null = pesanan lama dibayar Keteng)
  payment_url    String?
  paid_at        DateTime?
  expires_at     DateTime?
  created_at     DateTime  @default(now())

  items OrderItem[]

  @@index([user_id, created_at(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id          String           @id @default(uuid())
  order_id    String
  order       Order            @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id  String?
  product     MerchantProduct? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  merchant_id String?
  merchant    Merchant?        @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  branch_id   String?
  branch      MerchantBranch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  name        String // snapshot nama produk
  unit_price  Int
  qty         Int

  vouchers Voucher[]

  @@index([order_id])
  @@map("order_items")
}

// Kabar untuk user (lonceng di TopBar).
model Notification {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  kind       String // tukar | pundi | voucher | tera | lelang | sistem
  title      String
  body       String?
  href       String?
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, read_at])
  @@index([user_id, created_at(sort: Desc)])
  @@map("notifications")
}

model MerchantApplication {
  id              String   @id @default(uuid())
  loji_name       String
  category        String
  owner_name      String
  whatsapp        String
  join_flash_sale Boolean  @default(false)
  status          String   @default("pending") // pending | approved | rejected
  applicant_id    String?
  applicant       User?    @relation(fields: [applicant_id], references: [id], onDelete: SetNull)
  created_at      DateTime @default(now())

  @@map("merchant_applications")
}

model Follow {
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  merchant_id String
  merchant    Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@id([user_id, merchant_id])
  @@map("follows")
}

// ============================================================
// Balai Lelang — deal_price & set_price RAHASIA (jangan pernah di-select untuk publik)
// ============================================================
model Auction {
  id               String    @id @default(uuid())
  type             String    @default("reguler") // reguler | vendu
  clue_category    String
  clue_name_masked String
  normal_price     Int
  facilities       String[]  @default([])
  deal_price       Int? // RAHASIA
  set_price        Int? // RAHASIA (harga yang ditebak)
  status           String    @default("kumpul") // kumpul|tebak|jeda|final|pemenang|bayar|selesai
  capacity         Int       @default(10)
  starts_at        DateTime?
  phase_ends_at    DateTime?
  winner_id        String?
  winner           User?     @relation(fields: [winner_id], references: [id], onDelete: SetNull)
  winning_guess    Int?
  created_at       DateTime  @default(now())

  participants AuctionParticipant[]
  guesses      AuctionGuess[]

  @@map("auctions")
}

model AuctionParticipant {
  auction_id String
  auction    Auction  @relation(fields: [auction_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  joined_at  DateTime @default(now())

  @@id([auction_id, user_id])
  @@map("auction_participants")
}

model AuctionGuess {
  id         String   @id @default(uuid())
  auction_id String
  auction    Auction  @relation(fields: [auction_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  round      Int      @default(1)
  guess      Int
  created_at DateTime @default(now())

  @@index([auction_id, user_id])
  @@map("auction_guesses")
}

// ============================================================
// Neraca Harga
// ============================================================
model PriceListing {
  id                String    @id @default(uuid())
  product_key       String
  merchant_id       String?
  merchant          Merchant? @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  source_type       String    @default("merchant") // merchant | feed | scrape
  loji_name         String
  is_sealed         Boolean   @default(false)
  rating            Decimal   @default(0) @db.Decimal(2, 1)
  price             Int
  is_verified_price Boolean   @default(false)
  updated_at        DateTime  @default(now())

  @@index([product_key, price])
  @@map("price_listings")
}

// ============================================================
// Tukar Guling
// ============================================================
model BarterItem {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  est_value  Int
  want_text  String?
  city       String?
  tone       String   @default("sage")
  photo_url  String?
  status     String   @default("aktif") // aktif | dalam_tukar | ditutup | ditukar
  created_at DateTime @default(now())

  // Taksiran sistem (lib/domain/taksiran.ts). est_value = nilai tengah, tidak diketik user.
  category       String?
  categoryRef    BarterCategory? @relation(fields: [category], references: [slug])
  qty            Float? // komoditas: jumlah satuan (kg/liter)
  purchase_price Int? // aset: harga beli
  purchase_year  Int?
  checklist      Json? // { [key]: true } = kekurangan yang diakui
  serial_number  String? // IMEI / nomor rangka / SN
  est_low        Int?
  est_high       Int?
  ship_weight_kg Float? // dikunci dari kategori

  // Juru Taksir v2 (riset harga pasar)
  bought_condition String? // baru | bekas — kondisi saat dibeli
  production_year  Int? // tahun rilis/produksi
  is_collectible   Boolean        @default(false) // koleksi/klasik/antik: tanpa penyusutan
  research_id      String?
  research         PriceResearch? @relation(fields: [research_id], references: [id], onDelete: SetNull)
  valuation_method String? // pasar | baru | buku | koleksi | komoditas | penaksir
  accuracy         String? // tinggi | sedang | rendah | ditera
  appraisal_status String         @default("none") // none | diminta | ditera
  appraisal_note   String?

  dealsAsA BarterDeal[] @relation("DealItemA")
  dealsAsB BarterDeal[] @relation("DealItemB")

  @@index([status])
  @@index([serial_number])
  @@map("barter_items")
}

// Alamat kirim milik user (dipakai mode Kirim Tukar Guling). Wilayah = ID KiriminAja.
model UserAddress {
  id             String   @id @default(uuid())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  label          String   @default("Rumah")
  name           String
  phone          String
  address        String // jalan, nomor, RT/RW
  area           String // "Kelurahan, Kecamatan, Kota, Provinsi, Kodepos" dari pencarian
  district_id    Int // kecamatan_id KiriminAja
  subdistrict_id Int // kelurahan_id KiriminAja
  zipcode        String
  lat            Float
  lng            Float
  created_at     DateTime @default(now())

  @@index([user_id])
  @@map("user_addresses")
}

// Satu paket dalam tukar mode Kirim. a_to_b = barang A dikirim ke B (ongkir dibayar B, penerima).
model BarterShipment {
  id            String     @id @default(uuid())
  deal_id       String
  deal          BarterDeal @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  leg           String // a_to_b | b_to_a
  payer_id      String // penerima paket = pembayar ongkir
  origin        Json // snapshot alamat pengirim
  destination   Json // snapshot alamat penerima
  weight_g      Int
  length_cm     Int
  width_cm      Int
  height_cm     Int
  item_value    Int
  courier       String // kode kurir (service) KiriminAja, mis. jne
  service_type  String // mis. REG23
  service_name  String
  etd           String?
  shipping_cost Int
  insurance     Int        @default(0)
  order_id      String?    @unique // ID kita di KiriminAja (≤ 20 karakter)
  pickup_number String?
  awb           String?
  // quoted | paid | requested | shipped | delivered | canceled | returned | problem | failed
  status        String     @default("quoted")
  status_text   String?
  events        Json       @default("[]")
  shipped_at    DateTime?
  delivered_at  DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  @@unique([deal_id, leg])
  @@map("barter_shipments")
}

// Hasil riset harga pasar Juru Taksir (cache 7 hari per kueri+kategori, dipakai bersama antar user).
model PriceResearch {
  id         String   @id @default(uuid())
  query_key  String   @unique
  query_text String
  category   String
  pembanding Json     @default("[]") // [{sumber, judul, harga, kondisi, url, asal}]
  statistik  Json     @default("{}") // {baru: Ringkas|null, bekas: Ringkas|null}
  sumber_ok  String[] @default([]) // sumber yang berhasil dihubungi
  created_at DateTime @default(now())
  expires_at DateTime

  items BarterItem[]

  @@map("price_research")
}

// Kategori taksiran. kind: komoditas (qty × harga) | aset (penyusutan × kondisi).
model BarterCategory {
  slug           String  @id
  name           String
  kind           String // komoditas | aset
  unit           String? // komoditas: kg | liter
  rate_y1        Float   @default(0) // aset: susut tahun pertama (0.2 = 20%)
  rate_next      Float   @default(0) // aset: susut per tahun berikutnya
  floor_pct      Float   @default(0.1) // aset: nilai minimum terhadap harga beli
  ship_weight_kg Float // aset: per barang; komoditas: per satuan
  ship_length_cm Int? // aset: dimensi paket (volumetrik kurir); komoditas dihitung dari berat
  ship_width_cm  Int?
  ship_height_cm Int?
  needs_serial   Boolean @default(false)
  serial_label   String? // "IMEI", "Nomor rangka", …
  checklist      Json // [{ key, q, penalty }]
  sort           Int     @default(0)
  active         Boolean @default(true)

  items  BarterItem[]
  prices CommodityPrice[]

  @@map("barter_categories")
}

// Riwayat harga komoditas per satuan (terbaru dipakai). Diisi admin; source feed nanti.
model CommodityPrice {
  id             String         @id @default(uuid())
  category_slug  String
  category       BarterCategory @relation(fields: [category_slug], references: [slug], onDelete: Cascade)
  price_per_unit Int
  source         String         @default("admin") // admin | feed
  note           String?
  created_at     DateTime       @default(now())

  @@index([category_slug, created_at(sort: Desc)])
  @@map("commodity_prices")
}

model BarterDeal {
  id           String     @id @default(uuid())
  item_a       String
  itemA        BarterItem @relation("DealItemA", fields: [item_a], references: [id], onDelete: Cascade)
  item_b       String
  itemB        BarterItem @relation("DealItemB", fields: [item_b], references: [id], onDelete: Cascade)
  topup_keping Int        @default(0)
  // proposed | agreed | dikirim | diterima | done | rejected | cancelled | expired | disputed | resolved
  // (lib/domain/tukar-aturan.ts)
  status       String     @default("proposed")
  created_at   DateTime   @default(now())

  proposer_id   String? // pemilik item_a saat diajukan
  mode          String    @default("cod") // cod | kirim (M4)
  value_a       Int? // snapshot taksiran saat diajukan
  value_b       Int?
  topup_from    String? // a | b — siapa yang menambah Keteng
  fee_a         Int       @default(0) // bea Tukar masing-masing pihak
  fee_b         Int       @default(0)
  agreed_at     DateTime?
  expires_at    DateTime?
  meet_type     String? // jenis Titik Aman
  meet_place    String? // nama tempat umum (bukan alamat rumah)
  scanned_a_at  DateTime? // kode A sudah dipindai B
  scanned_b_at  DateTime? // kode B sudah dipindai A
  scan_fails    Int       @default(0)
  cancel_reason String?
  fault_party   String? // a | b
  closed_at     DateTime?

  // Mode Kirim (KiriminAja)
  address_a_id   String? // alamat pemilik item A (asal paket A, tujuan paket B)
  address_b_id   String?
  deposit_a      Int       @default(0)
  deposit_b      Int       @default(0)
  confirmed_a_at DateTime? // A mengonfirmasi barang B diterima & sesuai
  confirmed_b_at DateTime?

  shipments BarterShipment[]

  ratings BarterRating[]

  @@index([status, expires_at])
  @@map("barter_deals")
}

model BarterRating {
  id         String     @id @default(uuid())
  deal_id    String
  deal       BarterDeal @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  rater_id   String
  rater      User       @relation("RatingRater", fields: [rater_id], references: [id], onDelete: Cascade)
  ratee_id   String
  ratee      User       @relation("RatingRatee", fields: [ratee_id], references: [id], onDelete: Cascade)
  stars      Int // 1–5 (divalidasi di lib/domain/tukar.ts)
  comment    String?
  created_at DateTime   @default(now())

  @@unique([deal_id, rater_id])
  @@map("barter_ratings")
}

// ============================================================
// Kabar
// ============================================================
model Article {
  id           String    @id @default(uuid())
  slug         String    @unique
  title        String
  tag          String
  excerpt      String?
  cover_tone   String    @default("indigo")
  body         String[]  @default([])
  published_at DateTime?
  created_at   DateTime  @default(now())

  @@index([published_at(sort: Desc)])
  @@map("articles")
}

// ============================================================
// Akun: profil, Pundi, Surat Jalan, peran staf, pengaturan
// ============================================================
model Profile {
  id          String    @id
  user        User      @relation(fields: [id], references: [id], onDelete: Cascade)
  full_name   String?
  level       UserLevel @default(pelanggan_kecil)
  stamps      Int       @default(0) // Cap loyalti
  total_spend Int       @default(0)
  created_at  DateTime  @default(now())

  @@map("profiles")
}

model Wallet {
  user_id    String   @id
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  balance    Int      @default(0) // Keping (Rp)
  updated_at DateTime @default(now())

  @@map("wallets")
}

model WalletTransaction {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount     Int // +isi / -belanja
  kind       String // isi | bonus | belanja | tebus | hadiah | tahan | lepas | bea_tukar | terima_tukar
  note       String?
  created_at DateTime @default(now())

  @@index([user_id, created_at(sort: Desc)])
  @@map("wallet_transactions")
}

// Keteng yang ditahan (rekber) — sudah dipotong dari Wallet.balance saat ditahan.
// Selesai: diambil (bea → platform), dilepas (ke pihak lain), dikembalikan (ke pemilik).
model WalletHold {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deal_id    String?
  amount     Int
  kind       String // bea | tambah | deposit | ongkir
  status     String   @default("ditahan") // ditahan | diambil | dilepas | dikembalikan
  created_at DateTime @default(now())
  settled_at DateTime?

  @@index([user_id, status])
  @@index([deal_id])
  @@map("wallet_holds")
}

// Isi Pundi lewat DOKU Checkout. Keteng dikredit sekali saat notifikasi/cek status SUCCESS.
model TopupOrder {
  id             String    @id @default(uuid())
  user_id        String
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  invoice_number String    @unique
  package_id     String
  price          Int // rupiah yang dibayar
  keteng         Int // Keteng yang masuk (termasuk bonus)
  status         String    @default("pending") // pending | paid | failed | expired
  provider       String    @default("doku") // doku | tiruan
  payment_url    String?
  channel        String?
  paid_at        DateTime?
  expires_at     DateTime
  created_at     DateTime  @default(now())
  biaya_bayar    Int       @default(0) // biaya DOKU yang ditanggung pembeli (price = keteng + biaya_bayar)
  metode         String?
  // Bayar Langsung: setelah lunas, Keteng masuk lalu `tujuan` dijalankan otomatis (lib/domain/bayar-langsung.ts).
  tujuan         String    @default("isi") // isi | belanja | tukar_ajukan | tukar_terima | tukar_ongkir
  muatan         Json? // parameter aksi tujuan
  tujuan_status  String? // menunggu | diproses | berhasil | gagal (null untuk isi)
  tujuan_hasil   String? // ringkasan / alasan gagal
  tujuan_ref     String? // orderId / dealId hasil

  @@index([user_id, created_at(sort: Desc)])
  @@map("topup_orders")
}

model Voucher {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  note       String?
  kind       String    @default("lelang") // lelang | evoucher | hadiah
  status     String    @default("aktif") // aktif | terpakai | kadaluarsa
  expires_at DateTime?
  created_at DateTime  @default(now())

  // Kode tebus + asal voucher. Voucher lapak ditebus petugas lapak di cabangnya; voucher lelang oleh admin.
  code          String?          @unique
  merchant_id   String?
  merchant      Merchant?        @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  product_id    String?
  product       MerchantProduct? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  branch_id     String?
  branch        MerchantBranch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  order_item_id String?
  orderItem     OrderItem?       @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  redeemed_at   DateTime?
  redeemed_by   String? // user id petugas/admin

  @@index([merchant_id, status])
  @@map("vouchers")
}

model StaffRole {
  user_id    String        @id
  user       User          @relation("StaffRoleUser", fields: [user_id], references: [id], onDelete: Cascade)
  role       StaffRoleKind
  granted_by String?
  granter    User?         @relation("StaffRoleGrantedBy", fields: [granted_by], references: [id], onDelete: SetNull)
  created_at DateTime      @default(now())

  @@map("staff_roles")
}

model Setting {
  key        String   @id
  value      String?
  updated_at DateTime @default(now())

  @@map("settings")
}
